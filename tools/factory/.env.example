# Станція заливки fusion: скопіюйте в tools/factory/.env і заповніть. .env у .gitignore - у git не потрапляє.
# Змінна, вже задана в оточенні (export / VAR=... python ...), має пріоритет над цим файлом.

# prod | dev. Значення за замовчуванням немає навмисно; можна не задавати тут і передавати --stage.
FACTORY_STAGE=

# Особисті API-токени з адмін-панелі (Акаунт -> API-токени). Prod і dev - різні панелі й різні токени.
# Якщо токен для вибраного середовища порожній, скрипт запитає його прихованим вводом.
JAAM_FACTORY_TOKEN_PROD=
JAAM_FACTORY_TOKEN_DEV=

# 2.4 ГГц мережа станції: плата завантажує по ній робочу прошивку (OTA), а потім забуває її.
FACTORY_WIFI_SSID=
FACTORY_WIFI_PASS=
